<?xml version="1.0" encoding="UTF-8"?>
<!--
    Entitlements for the Dub macOS app. Written from `apple/project.yml`
    (the target's `entitlements.properties`); change them there.

    Sandbox stays off: Dub talks to arbitrary CoreAudio devices and reads
    other DJ apps' libraries where they live.

    Audio input: releases are signed with the hardened runtime for
    notarization (`make dist`), and under it macOS hands an app without
    this entitlement silence from every input — the decks would hear no
    timecode. Debug builds run without the runtime and ignore it.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
