#!/usr/bin/env bash
#
# pre-push — run the CI gates that have actually broken `main`.
#
# Every red push to main so far failed on one of three checks, each of
# which takes seconds locally: `cargo fmt --check`, `cargo clippy -D
# warnings`, and `scripts/check-docs.sh`. Nothing ran them before the
# code landed, so the break was only discovered minutes later in CI, on
# a branch nobody was watching. This hook closes that gap at the last
# moment where fixing it is still cheap.
#
# The test suite runs here too, since it stopped being expensive: it
# was ~11 minutes, which was too long to sit in front of a push, but
# nearly all of that turned out to be process-exec overhead from a
# bloated target/debug/deps rather than the tests themselves (see
# LESSONS). It is ~26 s now. Set DUB_PREPUSH_TESTS=0 to skip it on a
# slow machine or a huge rebuild.
#
# The Swift snapshot suite runs here as well, and *only* here: GitHub
# CI has no macOS app job, so `make ci` deliberately mirrors what CI
# runs and this is the one gate that has to be local. It earned the
# slot — `test_ripReviewPanel_*` sat red for four days after the
# Identify button landed without re-recorded baselines, because
# nothing ran the suite unless someone remembered to. It costs ~30 s
# when the xcframework is current, and a couple of minutes when a
# Rust FFI change forces a universal rebuild first. Set
# DUB_PREPUSH_SNAPSHOT=0 to skip it; it skips itself when there is no
# xcodebuild (a non-Mac clone, or Xcode not installed).
#
# Install: `make hooks` (or `git config core.hooksPath .githooks`).
# Bypass once: `git push --no-verify`.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_ROOT}"

FAILED=()

run_gate() {
    local name="$1"
    shift
    printf '  %-28s' "${name}"
    if "$@" >/tmp/dub-prepush.$$ 2>&1; then
        echo "ok"
    else
        echo "FAIL"
        FAILED+=("${name}")
        sed 's/^/      /' /tmp/dub-prepush.$$ | tail -25
    fi
    rm -f /tmp/dub-prepush.$$
}

echo "pre-push: running CI gates (bypass with --no-verify)"

run_gate "cargo fmt --check"  cargo fmt --all -- --check
run_gate "cargo clippy"       cargo clippy --workspace --all-targets -- -D warnings
run_gate "check-docs"         ./scripts/check-docs.sh

if [[ "${DUB_PREPUSH_TESTS:-1}" == "1" ]]; then
    run_gate "cargo nextest"  cargo nextest run --workspace
fi

if [[ "${DUB_PREPUSH_SNAPSHOT:-1}" == "1" ]]; then
    if command -v xcodebuild >/dev/null 2>&1; then
        run_gate "swift snapshots"  make snapshot
    else
        printf '  %-28s%s\n' "swift snapshots" "skipped (no xcodebuild)"
    fi
fi

if (( ${#FAILED[@]} > 0 )); then
    echo
    echo "pre-push: BLOCKED — ${FAILED[*]} would fail in CI."
    echo "  fix, or push anyway with: git push --no-verify"
    exit 1
fi

echo "pre-push: all gates green"
exit 0
