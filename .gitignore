# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Lockfiles - keep
# (Cargo.lock IS committed for binaries; this workspace has bins so we keep it)

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Apple build outputs
apple/build/
apple/DerivedData/
apple/*.xcodeproj/
apple/*.xcworkspace/
*.xcframework/
# Fallback DerivedData location if Xcode is invoked outside `make app`
# (Makefile pins DerivedData to apple/build/, but Xcode.app defaults to a
# root-level build/ when opened directly).
/build/
DerivedData/
# UniFFI-generated Swift bindings — regenerated by scripts/build-xcframework.sh
apple/DubShared/Sources/DubCore/Generated/
# Swift Package Manager build state inside the package
apple/DubShared/.build/
apple/DubShared/.swiftpm/
apple/DubShared/Package.resolved

# Test / coverage outputs
coverage/
*.profraw
*.profdata
target/llvm-cov-target/
# insta snapshot review artifacts — regenerated on every `cargo insta test`;
# accepted snapshots live in `*.snap`, never the pending review log.
*.pending-snap
.*.pending-snap

# Fuzz outputs
fuzz/target/
fuzz/corpus/
fuzz/artifacts/

# Local logs / dumps
# Rig capture recordings at the repo root (deckA.wav etc.) — multi-MB,
# session-specific, replayed locally via the dub-engine replay harness.
# Committed wav fixtures live under crates/*/tests/fixtures/.
/*.wav
# Personal DJ-library exports dropped at the repo root for importer
# validation (Traktor NML, iTunes/rekordbox XML). Never committed — they
# hold the developer's real library; anonymised golden fixtures live under
# crates/dub-library/tests/fixtures/.
/*.nml
/iTunes Library.xml
/rekordbox*.xml
*.log
crashes/
.cursor/settings.json
# Claude Code: share settings.json + hooks/, keep per-user overrides local
.claude/settings.local.json

# Env / secrets
.env
.env.local
*.pem
*.code-workspace

# Apple developer artifacts
ExportOptions.plist
*.p12

# SwiftUI snapshot baselines ARE tracked — they are the regression gate,
# and a gate no review ever sees is not one. They are excluded from the
# DubTests *resources* phase in apple/project.yml, so deleting one to
# re-record it does not break the generated project.

# Rip tuning baselines — real record captures (748 MB of 24-bit FLAC).
# Ground truth behind every constant in `dub-rip/src/gaps.rs`; kept out of
# git for size, replayed with `dub rip-tune`. See testdata/rip-baselines/.
testdata/rip-baselines/*.flac
testdata/rip-baselines/*.wav

# Full 60 s timecode captures — kept for cutting new fixtures, too big to
# track. The 10 s excerpts in testdata/timecode/ ARE tracked, because the
# tests that read them have to run in CI.
testdata/timecode/full/
